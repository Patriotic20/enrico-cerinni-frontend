# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/dist
/build

# leftover Next.js build cache from before the Vite migration (safe to delete)
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!env.example
!env.production

# temporary files
cookies.txt
*.tmp
*.temp

# IDE files
*.code-workspace
.vscode/settings.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# playwright
.playwright-mcp/
