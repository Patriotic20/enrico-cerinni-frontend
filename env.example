# Frontend Environment Variables
#
# Vite only exposes variables prefixed with VITE_, and it inlines them at BUILD
# time — changing one requires rebuilding (or restarting `npm run dev`).

# Base URL of the backend API. Leave unset in development to use the dev proxy.
VITE_API_URL=http://localhost:8000

VITE_APP_NAME=Enrico Cerrini
VITE_APP_VERSION=1.0.0
